{
  "name": "pinpoint",
  "private": true,
  "version": "0.1.0",
  "description": "Pinpoint — explore the world's flags and play geography games",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,party -c magenta,cyan \"npm run dev -w @pinpoint/web\" \"npm run dev -w @pinpoint/realtime\"",
    "dev:web": "npm run dev -w @pinpoint/web",
    "dev:party": "npm run dev -w @pinpoint/realtime",
    "build": "npm run build -w @pinpoint/web",
    "data": "npm run build -w @pinpoint/data",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @pinpoint/game"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
