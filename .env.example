# Public address of the site, e.g. https://pinpoint.example.com
SITE_URL=http://localhost:3000
# Leave empty in production when /socket.io is routed to the realtime service on the same domain.
# In development the app uses http://<host>:4000 automatically.
REALTIME_URL=

# Accounts
# Signs the login cookie. 32+ random characters, e.g. the output of: openssl rand -hex 32
AUTH_SECRET=
# Google sign-in (optional). Create an OAuth client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   <SITE_URL>/api/auth/google/callback   (for local dev: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
